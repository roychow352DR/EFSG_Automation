u865f\u53c3\u52a0\u6b64\u63a8\u5ee3\uff0c\u5982\u53c3\u52a0\u8005\u65bc\u63a8\u5ee3\u671f\u9593\u4f7f\u7528\u591a\u65bc\u4e00\u500b\u7684\u4ea4\u6613\u5e33\u865f\u767b\u8a18\uff0c\u672c\u516c\u53f8\u6703\u4ee5\u767b\u8a18\u6642\u9593\u8f03\u5148\u7684\u70ba\u51c6\uff0c\u5426\u5247\u53ef\u88ab\u53d6\u6d88\u8cc7\u683c\u3002\n        5. \u6b64\u9650\u6642\u4efb\u52d9\u5305\u62ec\u4ee5\u4e0b\u56db\u500b\u4efb\u52d9:\n        i. \u4efb\u52d9\u4e00 - \u958b\u8a2d\u771f\u5be6\u4ea4\u6613\u6236\u53e3\n        \u6b64\u63a8\u5ee3\u7684\u958b\u6236\u767b\u8a18\u8a08\u7b97\u6642\u9593\u70ba2023\u5e7411\u67081\u65e5\u81f32023\u5e7411\u670830\u65e5\uff0c\u53c3\u52a0\u8005\u958b\u6236\u524d\u5fc5\u9808\u5148\u65bc\u4efb\u52d9\u767b\u8a18\u9801\u9762\u9032\u884c\u767b\u8a18\u65b9\u624d\u751f\u6548\u3002\n        \u4f8b\u5b50:\n        - \u5ba2\u6236A\u57282023\u5e7411\u670810\u65e5\u4e0a\u5348\u767b\u8a18\u4efb\u52d9\uff0c\u540c\u65e5\u4e0b\u5348\u6210\u529f\u958b\u6236\uff0c\u8996\u70ba\u5b8c\u6210\u4efb\u52d9\u3002\n        - \u5ba2\u6236B\u57282023\u5e7411\u67082\u65e5\u6210\u529f\u958b\u6236\uff0c\u7136\u5f8c\u57282023\u5e7411\u670828\u65e5\u767b\u8a18\u4efb\u52d9\uff0c\u8996\u70ba\u7121\u6548\u767b\u8a18\u3002\n        ii. \u4efb\u52d9\u4e8c \u2013 \u5b58\u5165\u6307\u5b9a\u91d1\u984d:\n        \u6b64\u63a8\u5ee3\u7684\u5165\u91d1\u6703\u65bc\u63a8\u5ee3\u671f\u5167\u767b\u8a18\u5f8c\u958b\u59cb\u8a08\u7b97\u81f32023\u5e7411\u670830\u65e5\uff0c\u63a8\u5ee3\u671f\u5167\u9700\u8981\u7e3d\u5165\u91d1\u91d1\u984d\u4e0d\u5c11\u65bc\u6e2f\u5e6330,000\u5143\uff0c2023\u5e7412\u670831\u65e5\u524d\u4e0d\u53ef\u51fa\u91d1\uff0c\u5426\u5247\u4efb\u52d9\u8996\u70ba\u5931\u6557\u3002\n        \u4f8b\u5b50:\n        - \u5ba2\u6236A\u57282023\u5e7411\u670815\u65e5\u767b\u8a18\u4efb\u52d9\u5f8c\u5165\u91d1\u6e2f\u5e6340,000\u5143\uff0c\u65bc2023\u5e7412\u670831\u65e5\u524d\u6c92\u6709\u9032\u884c\u51fa\u91d1\uff0c\u8996\u70ba\u5b8c\u6210\u4efb\u52d9\u3002\n        - \u5ba2\u6236B\u57282023\u5e7411\u67081\u65e5\u5728\u767b\u8a18\u4efb\u52d9\u5f8c\u5b58\u5165\u6e2f\u5e6350,000\u5143\uff0c\u57282023\u5e7412\u670829\u65e5\u51fa\u91d1\u6e2f\u5e6315,000\u5143\uff0c\u8996\u70ba\u7121\u6548\u767b\u8a18\u3002\n        iii. \u4efb\u52d9\u4e09 - \u4ea4\u6613:\n        \u6b64\u63a8\u5ee3\u7684\u4ea4\u6613\u624b\u6578\u6703\u65bc\u63a8\u5ee3\u671f\u5167\u767b\u8a18\u5f8c\u958b\u59cb\u8a08\u7b97\u81f32023\u5e7411\u670830\u65e5\uff0c\u6709\u6548\u7684\u4ea4\u6613\u70ba\u4efb\u4f55\u7522\u54c1\u548c\u4efb\u4f55\u4ea4\u6613\u65b9\u5411(\u8cb7\u5347/\u8dcc)\u7e3d\u5171\u4e0d\u5c11\u65bc\u4e00\u624b(\u53c3\u52a0\u8005\u53ef\u9032\u884c\u591a\u6b21\u4ea4\u6613\uff0c\u7e3d\u624b\u6578\u4e0d\u5c11\u65bc\u4e00\u624b\u5373\u53ef)\uff0c\u53ca\u5176\u4ea4\u6613\u6307\u4ee4\u76f8\u8ddd\u7684\u6642\u9593\u4e0d\u5c11\u65bc\u5341\u5206\u9418\u6216\u76f8\u540c\u7522\u54c1\u4e0d\u540c\u4ea4\u6613\u65b9\u5411\u7684\u6210\u4ea4\u50f9\u5dee\u50f9\u4e0d\u5c11\u65bc\u5341\u9ede\u5b50\uff0c\u6709\u95dc\u8cc7\u6599\u4ee5\u4ea4\u6613\u7cfb\u7d71\u70ba\u51c6\u3002\n        \u4f8b\u5b50:\n        - \u5ba2\u6236A\u57282023\u5e7411\u670815\u65e514:15\u5728\u4efb\u52d9\u767b\u8a18\u9801\u9762\u767b\u8a18\u9032\u884c\u4efb\u52d9\u5f8c\u6cbd\u8ce3\u4e00\u624bEUR/USD\uff0c\u4e262023\u5e7411\u670815\u65e515:00\u5e73\u5009\uff0c\u5176\u4ea4\u6613\u8996\u70ba\u5408\u8cc7\u683c\u7684\u4ea4\u6613\u3002\n        - \u5ba2\u6236B\u57282023\u5e7411\u670815\u65e514:15\u5728\u4efb\u52d9\u767b\u8a18\u9801\u9762\u767b\u8a18\u9032\u884c\u4efb\u52d9\u5f8c\u6cbd\u8ce3\u4e00\u624bEUR/USD\uff0c\u4e262023\u5e7411\u670815\u65e514:20\u5e73\u5009\uff0c\u56e0\u70ba\u4ea4\u6613\u6307\u4ee4\u76f8\u8ddd\u7684\u6642\u9593\u5c11\u65bc\u5341\u5206\u9418\uff0c\u56e0\u6b64\u5176\u4ea4\u6613\u624b\u6578\u5c07\u4e0d\u88ab\u8a08\u7b97\u3002\n        iv. \u4efb\u52d9\u56db - \u63a8\u85a6\u670b\u53cb:\n        \u73fe\u6709\u5ba2\u6236\u53ef\u4e8e\u63a8\u5ee3\u671f\u5167\u63a8\u85a6\u597d\u53cb\u6210\u529f\u5b8c\u6210\u958b\u8a2d\u771f\u5be6\u4ea4\u6613\u6236\u53e3\u3002\n        6. \u63a8\u5ee3\u767b\u8a18\u6642\u9593\u4e36\u5b58\u6b3e\u91d1\u984d\u53ca\u4ea4\u6613\u624b\u6578\u8a08\u7b97\u5c07\u6703\u4ee5\u672c\u516c\u53f8\u7cfb\u7d71\u70ba\u51c6\u3002\n        7. \u5982\u900f\u904e\u4fe1\u7528\u5361\u5b58\u6b3e\uff0c\u9aee\u5361\u6a5f\u69cb\u53ef\u80fd\u6703\u6536\u53d6\u624b\u7e8c\u8cbb\uff0c\u5b58\u6b3e\u91d1\u984d\u7684\u8a08\u7b97\u4ee5\u5be6\u969b\u5b58\u5165\u5230\u4ea4\u6613\u5e33\u6236\u7684\u91d1\u984d\u70ba\u51c6\n        8. \u5982\u53c3\u52a0\u8005\u57282023\u5e7412\u670831\u65e5\u524d\u51fa\u91d1\u5c07\u88ab\u53d6\u6d88\u7372\u734e\u8cc7\u683c\u800c\u4e0d\u4f5c\u53e6\u884c\u901a\u77e5\u3002\n        9. \u6bcf\u4f4d\u53c3\u52a0\u8005\u6bcf\u500b\u4efb\u52d9\u53ea\u53ef\u767b\u8a18\u53ca\u5f97\u734e\u4e00\u6b21\u3002\n        10. \u53c3\u52a0\u8005\u4e0d\u80fd\u540c\u6642\u53c3\u52a0\u672c\u516c\u53f8\u5176\u4ed6\u63a8\u5ee3\u6d3b\u52d5\uff0c\u9664\u6307\u5b9a\u6d3b\u52d5\u9664\u5916\u3002\n        11. \u6709\u6548\u7684\u4ea4\u6613\u624b\u6578\u70ba\u76f8\u540c\u7522\u54c1\u4e0d\u540c\u4ea4\u6613\u65b9\u5411\u7684\u4ea4\u6613\u6307\u4ee4\u76f8\u8ddd\u7684\u6642\u9593\u4e0d\u5c11\u65bc\u5341\u5206\u9418\uff0c\u6216\u76f8\u540c\u7522\u54c1\u4e0d\u540c\u4ea4\u6613\u65b9\u5411\u7684\u6210\u4ea4\u50f9\u5dee\u50f9\u4e0d\u5c11\u65bc\u5341\u9ede\u5b50\uff0c\u6709\u95dc\u8cc7\u6599\u4ee5\u4ea4\u6613\u7cfb\u7d71\u70ba\u51c6\u3002\n        12. \u4ea4\u6613\u624b\u6578\u5b9a\u7fa9\uff1a\uff08\u958b\u5009\u624b\u6578+\u5e73\u5009\u624b\u6578\uff09/ 2\uff0c\u5176\u4ed6\u4ea4\u6613\u7d30\u5247\u8acb\u53c3\u95b1\n        - \u82f1\u7687\u91d1\u878d\u96c6\u5718\uff08\u9999\u6e2f\uff09\u6709\u9650\u516c\u53f8\uff1a\u7522\u54c1\u7d30\u5247\u53ca\u4ea4\u6613\u898f\u5247\n        13. \u4eba\u6c11\u5e63\u516c\u65a4\u689d(RKG)\u4ea4\u6613\u624b\u6578\u8a08\u7b97\u65b9\u6cd5\uff1a\u6bcf3\u624b\u4eba\u6c11\u5e63\u516c\u65a4\u689d(RKG)\u76f8\u7b49\u65bc1\u624b\u6709\u6548\u4ea4\u6613\u624b\u6578\u3002\n        14. \u82e5\u767c\u73fe\u7570\u5e38\u4ea4\u6613\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u65bc\u4efb\u4f55\u5f62\u5f0f\u5c0d\u6c96\u5f0f\u4ea4\u6613\uff0c\u672c\u516c\u53f8\u6709\u6b0a\u53d6\u6d88\u5ba2\u6236\u53c3\u52a0\u8cc7\u683c\u3002\n        15. \u7a4d\u5206\u734e\u8cde\u65bc\u70ba2024\u5e741\u670810\u65e5\u524d\u5b58\u5165\u5ba2\u6236\u7684\u6703\u54e1\u5e33\u6236\u5167\u3002\n        16. \u6240\u6709\u7a4d\u5206\u734e\u8cde\u5747\u4e0d\u53ef\u9000\u63db\u6216\u514c\u63db\u73fe\u91d1\uff0c\u4ea6\u4e0d\u80fd\u66f4\u63db\u4e36\u9000\u6b3e\u4e36\u8f49\u8b93\u53ca\u8f49\u552e\u4e36\u66f4\u63db\u5176\u4ed6\u734e\u54c1\u53ca/\u6216\u6b3e\u8272\u66ff\u4ee3\u3002\n        17. \u82f1\u7687\u91d1\u878d\u96c6\u5718\u7684\u6240\u6709\u54e1\u5de5\u53ca\u5176\u89aa\u53cb\u5747\u4e0d\u80fd\u53c3\u8207\u6b64\u63a8\u5ee3\u3002\n        18. \u6709\u95dc\u672c\u63a8\u5ee3\u7684\u8a73\u60c5\u3001\u6539\u52d5\u6216\u53d6\u6d88\uff0c\u5c07\u4ee5\u672c\u516c\u53f8\u5728\u5b98\u65b9\u7db2\u7ad9https://www.empfs.com\u516c\u4f48\u7684\u70ba\u51c6\u3002\n        19. \u672c\u516c\u53f8\u4fdd\u7559\u66f4\u6539\u6b64\u689d\u6b3e\u53ca\u7d30\u5247\uff0c\u66f4\u6539\u6216\u7d42\u6b62\u4efb\u4f55\u512a\u60e0\u7684\u6b0a\u5229\uff0c\u800c\u6bcb\u9808\u53e6\u884c\u901a\u77e5\uff0c\u4e26\u4e00\u5207\u5747\u4ee5\u672c\u516c\u53f8\u4e4b\u89e3\u91cb\u70ba\u51c6\u3002\n        20. \u53c3\u52a0\u8005\u53c3\u52a0\u662f\u6b21\u63a8\u5ee3\u512a\u60e0\u53d7\u6b64\u689d\u6b3e\u7d04\u675f\uff0c\u53c3\u52a0\u6b64\u63a8\u5ee3\u5373\u4ee3\u8868\u540c\u610f\u689d\u6b3e\u53ca\u7d30\u5247\u3002\u5982\u672c\u516c\u53f8\u767c\u73fe\u53c3\u52a0\u8005\u9055\u53cd\u63a8\u5ee3\u689d\u6b3e\uff0c\u5176\u53c3\u52a0\u8cc7\u683c\u5c07\u88ab\u53d6\u6d88\u3002\u672c\u516c\u53f8\u4fdd\u7559\u6700\u7d42\u6c7a\u5b9a\u6b0a\u53ca\u6700\u7d42\u89e3\u91cb\u6b0a\uff0c\u4e26\u5c0d\u63a8\u5ee3\u53c3\u8207\u8005\u5177\u7d04\u675f\u529b\uff0c\u5982\u5c0d\u6b64\u512a\u60e0\u6709\u4efb\u4f55\u67e5\u8a62\uff0c\u6b61\u8fce\u81f4\u96fb +852 8206 2500 \u8207\u672c\u516c\u53f8\u5ba2\u6236\u670d\u52d9\u90e8\uf997\u7d61\u3002\n        21. \u5f97\u734e\u8005\u5982\u6709\u4efb\u4f55\u6d89\u5acc\u6b3a\u8a50\u3001\u9055\u53cd\u4efb\u4f55\u6cd5\u898f\u6216\u4e0d\u6070\u7576\u884c\u70ba\u800c\u88ab\u672c\u516c\u53f8\u7d42\u6b62\u5176\u5e33\u6236\uff0c\u672c\u516c\u53f8\u4fdd\u7559\u63a1\u53d6\u4efb\u4f55\u5fc5\u8981\u6cd5\u5f8b\u884c\u52d5\u7684\u6b0a\u5229\uff0c\u8ffd\u8a0e\u4efb\u4f55\u5df2\u8d08\u4e88\u7684\u734e\u54c1\u53ca\u56e0\u4e0a\u8ff0\u5f97\u734e\u8005\u4e4b\u884c\u70ba\u6240\u7522\u751f\u4efb\u4f55\u6cd5\u5f8b\u8cac\u4efb\u6216\u640d\u5931\u3002\n        22. \u63a8\u5ee3\u7d30\u5247\u672a\u8986\u84cb\u7684\u90e8\u5206\uff0c\u8acb\u53c3\u95b1\u672c\u516c\u53f8\u5ba2\u6236\u5354\u5b9a\u76f8\u95dc\u689d\u6b3e\u3002\n        23. \u672c\u63a8\u5ee3\u4e26\u4e0d\u69cb\u6210\u53ca\u4e0d\u61c9\u88ab\u8996\u70ba\u4efb\u4f55\u5efa\u8b70\u3001\u63a8\u92b7\u3001\u904a\u8aaa\u5ba2\u6236\u8a8d\u8cfc\u6216\u51fa\u552e\u4efb\u4f55\u6295\u8cc7\u7522\u54c1\u8207\u8cb7\u8ce3\u4efb\u4f55\u6295\u8cc7\u7522\u54c1\u3002\n        24. \u672c\u689d\u6b3e\u53ca\u7d30\u5247\u53d7\u9999\u6e2f\u7279\u5225\u884c\u653f\u5340\u6cd5\u5f8b\u6240\u7ba1\u8f44\uff0c\u4e26\u6309\u7167\u9999\u6e2f\u7279\u5225\u884c\u653f\u5340\u6cd5\u5f8b\u8a6e\u91cb\u3002\n        25. \u672c\u689d\u6b3e\u53ca\u7d30\u5247\u53d7\u73fe\u884c\u76e3\u7ba1\u898f\u5b9a\u7d04\u675f\u3002",already_joined:"\u60a8\u5df2\u7d93\u8a3b\u518a\u4e86\u6d3b\u52d5\uff0c\u611f\u8b1d\u60a8\u7684\u652f\u6301\u3002",contact_cs_title:"\u6211\u8cde\u4f60\u8cfa",contact_cs_content:"\u6210\u70ba\u6703\u54e1\u8b93\u4f60\u6bcf\u6b21\u4ea4\u6613\u8cfa\u5206\u63db\u8c50\u5bcc\u79ae\u54c1\u3002",my_reward_landing_title:"\u734e\u52f5\u4e2d\u5fc3",mission_centre_title:"\u4efb\u52d9\u4e2d\u5fc3",my_reward_button:"\u6211\u7684\u734e\u52f5",level_title:"\u76ee\u524d\u968e\u6bb5\uff1a",referral_code_title:"\u500b\u4eba\u63a8\u85a6\u78bc:",btn_earn_point:"\u5feb\u901f\u8cfa\u5206\u200b",btn_give_away