2d\u4e00\u4e2a\u4ea4\u6613\u8d26\u53f7\u53c2\u52a0\u6b64\u63a8\u5e7f\uff0c\u5982\u53c2\u52a0\u8005\u4e8e\u63a8\u5e7f\u671f\u95f4\u4f7f\u7528\u591a\u4e8e\u4e00\u4e2a\u7684\u4ea4\u6613\u8d26\u53f7\u767b\u8bb0\uff0c\u672c\u516c\u53f8\u4f1a\u4ee5\u767b\u8bb0\u65f6\u95f4\u8f83\u5148\u7684\u4e3a\u51c6\uff0c\u5426\u5219\u53ef\u88ab\u53d6\u6d88\u8d44\u683c\u3002\n        5. \u6b64\u9650\u65f6\u4efb\u52a1\u5305\u62ec\u4ee5\u4e0b\u56db\u4e2a\u4efb\u52a1:\n        i. \u4efb\u52a1\u4e00 - \u5f00\u8bbe\u771f\u5b9e\u4ea4\u6613\u6237\u53e3\n        \u6b64\u63a8\u5e7f\u7684\u5f00\u6237\u767b\u8bb0\u8ba1\u7b97\u65f6\u95f4\u4e3a2023\u5e7411\u67081\u65e5\u81f32023\u5e7411\u670830\u65e5\uff0c\u53c2\u52a0\u8005\u5f00\u6237\u524d\u5fc5\u987b\u5148\u4e8e\u4efb\u52a1\u767b\u8bb0\u9875\u9762\u8fdb\u884c\u767b\u8bb0\u65b9\u624d\u751f\u6548\u3002\n        \u4f8b\u5b50:\n        - \u5ba2\u6237A\u57282023\u5e7411\u670810\u65e5\u4e0a\u5348\u767b\u8bb0\u4efb\u52a1\uff0c\u540c\u65e5\u4e0b\u5348\u6210\u529f\u5f00\u6237\uff0c\u89c6\u4e3a\u5b8c\u6210\u4efb\u52a1\u3002\n        - \u5ba2\u6237B\u57282023\u5e7411\u67082\u65e5\u6210\u529f\u5f00\u6237\uff0c\u7136\u540e\u57282023\u5e7411\u670828\u65e5\u767b\u8bb0\u4efb\u52a1\uff0c\u89c6\u4e3a\u65e0\u6548\u767b\u8bb0\u3002\n        ii. \u4efb\u52a1\u4e8c \u2013 \u5b58\u5165\u6307\u5b9a\u91d1\u989d:\n        \u6b64\u63a8\u5e7f\u7684\u5165\u91d1\u4f1a\u4e8e\u63a8\u5e7f\u671f\u5185\u767b\u8bb0\u540e\u5f00\u59cb\u8ba1\u7b97\u81f32023\u5e7411\u670830\u65e5\uff0c\u63a8\u5e7f\u671f\u5185\u9700\u8981\u603b\u5165\u91d1\u91d1\u989d\u4e0d\u5c11\u4e8e\u6e2f\u5e0130,000\u5143\uff0c2023\u5e7412\u670831\u65e5\u524d\u4e0d\u53ef\u51fa\u91d1\uff0c\u5426\u5219\u4efb\u52a1\u89c6\u4e3a\u5931\u8d25\u3002\n        \u4f8b\u5b50:\n        - \u5ba2\u6237A\u57282023\u5e7411\u670815\u65e5\u767b\u8bb0\u4efb\u52a1\u540e\u5165\u91d1\u6e2f\u5e0140,000\u5143\uff0c\u4e8e2023\u5e7412\u670831\u65e5\u524d\u6ca1\u6709\u8fdb\u884c\u51fa\u91d1\uff0c\u89c6\u4e3a\u5b8c\u6210\u4efb\u52a1\u3002\n        - \u5ba2\u6237B\u57282023\u5e7411\u67081\u65e5\u5728\u767b\u8bb0\u4efb\u52a1\u540e\u5b58\u5165\u6e2f\u5e0150,000\u5143\uff0c\u57282023\u5e7412\u670829\u65e5\u51fa\u91d1\u6e2f\u5e0115,000\u5143\uff0c\u89c6\u4e3a\u65e0\u6548\u767b\u8bb0\u3002\n        iii. \u4efb\u52a1\u4e09 - \u4ea4\u6613:\n        \u6b64\u63a8\u5e7f\u7684\u4ea4\u6613\u624b\u6570\u4f1a\u4e8e\u63a8\u5e7f\u671f\u5185\u767b\u8bb0\u540e\u5f00\u59cb\u8ba1\u7b97\u81f32023\u5e7411\u670830\u65e5\uff0c\u6709\u6548\u7684\u4ea4\u6613\u4e3a\u4efb\u4f55\u4ea7\u54c1\u548c\u4efb\u4f55\u4ea4\u6613\u65b9\u5411(\u4e70\u5347/\u8dcc)\u603b\u5171\u4e0d\u5c11\u4e8e\u4e00\u624b(\u53c2\u52a0\u8005\u53ef\u8fdb\u884c\u591a\u6b21\u4ea4\u6613\uff0c\u603b\u624b\u6570\u4e0d\u5c11\u4e8e\u4e00\u624b\u5373\u53ef)\uff0c\u53ca\u5176\u4ea4\u6613\u6307\u4ee4\u76f8\u8ddd\u7684\u65f6\u95f4\u4e0d\u5c11\u4e8e\u5341\u5206\u949f\u6216\u76f8\u540c\u4ea7\u54c1\u4e0d\u540c\u4ea4\u6613\u65b9\u5411\u7684\u6210\u4ea4\u4ef7\u5dee\u4ef7\u4e0d\u5c11\u4e8e\u5341\u70b9\u5b50\uff0c\u6709\u5173\u6570\u636e\u4ee5\u4ea4\u6613\u7cfb\u7edf\u4e3a\u51c6\u3002\n        \u4f8b\u5b50:\n        - \u5ba2\u6237A\u57282023\u5e7411\u670815\u65e514:15\u5728\u4efb\u52a1\u767b\u8bb0\u9875\u9762\u767b\u8bb0\u8fdb\u884c\u4efb\u52a1\u540e\u6cbd\u5356\u4e00\u624bEUR/USD\uff0c\u5e762023\u5e7411\u670815\u65e515:00\u5e73\u4ed3\uff0c\u5176\u4ea4\u6613\u89c6\u4e3a\u5408\u8d44\u683c\u7684\u4ea4\u6613\u3002\n        - \u5ba2\u6237B\u57282023\u5e7411\u670815\u65e514:15\u5728\u4efb\u52a1\u767b\u8bb0\u9875\u9762\u767b\u8bb0\u8fdb\u884c\u4efb\u52a1\u540e\u6cbd\u5356\u4e00\u624bEUR/USD\uff0c\u5e762023\u5e7411\u670815\u65e514:20\u5e73\u4ed3\uff0c\u56e0\u4e3a\u4ea4\u6613\u6307\u4ee4\u76f8\u8ddd\u7684\u65f6\u95f4\u5c11\u4e8e\u5341\u5206\u949f\uff0c\u56e0\u6b64\u5176\u4ea4\u6613\u624b\u6570\u5c06\u4e0d\u88ab\u8ba1\u7b97\u3002\n        iv. \u4efb\u52a1\u56db - \u63a8\u8350\u670b\u53cb:\n        \u73b0\u6709\u5ba2\u6237\u53ef\u4e8e\u63a8\u5e7f\u671f\u5185\u63a8\u8350\u597d\u53cb\u6210\u529f\u5b8c\u6210\u5f00\u8bbe\u771f\u5b9e\u4ea4\u6613\u6237\u53e3\u3002\n        6. \u63a8\u5e7f\u767b\u8bb0\u65f6\u95f4\u4e36\u5b58\u6b3e\u91d1\u989d\u53ca\u4ea4\u6613\u624b\u6570\u8ba1\u7b97\u5c06\u4f1a\u4ee5\u672c\u516c\u53f8\u7cfb\u7edf\u4e3a\u51c6\u3002\n        7. \u5982\u900f\u8fc7\u4fe1\u7528\u5361\u5b58\u6b3e\uff0c\u53d1\u5361\u673a\u6784\u53ef\u80fd\u4f1a\u6536\u53d6\u624b\u7eed\u8d39\uff0c\u5b58\u6b3e\u91d1\u989d\u7684\u8ba1\u7b97\u4ee5\u5b9e\u9645\u5b58\u5165\u5230\u4ea4\u6613\u8d26\u6237\u7684\u91d1\u989d\u4e3a\u51c6\n        8. \u5982\u53c2\u52a0\u8005\u57282023\u5e7412\u670831\u65e5\u524d\u51fa\u91d1\u5c06\u88ab\u53d6\u6d88\u83b7\u5956\u8d44\u683c\u800c\u4e0d\u4f5c\u53e6\u884c\u901a\u77e5\u3002\n        9. \u6bcf\u4f4d\u53c2\u52a0\u8005\u6bcf\u4e2a\u4efb\u52a1\u53ea\u53ef\u767b\u8bb0\u53ca\u5f97\u5956\u4e00\u6b21\u3002\n        10. \u53c2\u52a0\u8005\u4e0d\u80fd\u540c\u65f6\u53c2\u52a0\u672c\u516c\u53f8\u5176\u4ed6\u63a8\u5e7f\u6d3b\u52a8\uff0c\u9664\u6307\u5b9a\u6d3b\u52a8\u9664\u5916\u3002\n        11. \u6709\u6548\u7684\u4ea4\u6613\u624b\u6570\u4e3a\u76f8\u540c\u4ea7\u54c1\u4e0d\u540c\u4ea4\u6613\u65b9\u5411\u7684\u4ea4\u6613\u6307\u4ee4\u76f8\u8ddd\u7684\u65f6\u95f4\u4e0d\u5c11\u4e8e\u5341\u5206\u949f\uff0c\u6216\u76f8\u540c\u4ea7\u54c1\u4e0d\u540c\u4ea4\u6613\u65b9\u5411\u7684\u6210\u4ea4\u4ef7\u5dee\u4ef7\u4e0d\u5c11\u4e8e\u5341\u70b9\u5b50\uff0c\u6709\u5173\u6570\u636e\u4ee5\u4ea4\u6613\u7cfb\u7edf\u4e3a\u51c6\u3002\n        12. \u4ea4\u6613\u624b\u6570\u5b9a\u4e49\uff1a\uff08\u5f00\u4ed3\u624b\u6570+\u5e73\u4ed3\u624b\u6570\uff09/ 2\uff0c\u5176\u4ed6\u4ea4\u6613\u7ec6\u5219\u8bf7\u53c2\u9605\n        - \u82f1\u7687\u91d1\u878d\u96c6\u56e2\uff08\u9999\u6e2f\uff09\u6709\u9650\u516c\u53f8\uff1a\u4ea7\u54c1\u7ec6\u5219\u53ca\u4ea4\u6613\u89c4\u5219\n        13. \u4eba\u6c11\u5e01\u516c\u65a4\u6761(RKG)\u4ea4\u6613\u624b\u6570\u8ba1\u7b97\u65b9\u6cd5\uff1a\u6bcf3\u624b\u4eba\u6c11\u5e01\u516c\u65a4\u6761(RKG)\u76f8\u7b49\u4e8e1\u624b\u6709\u6548\u4ea4\u6613\u624b\u6570\u3002\n        14. \u82e5\u53d1\u73b0\u5f02\u5e38\u4ea4\u6613\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u4efb\u4f55\u5f62\u5f0f\u5bf9\u51b2\u5f0f\u4ea4\u6613\uff0c\u672c\u516c\u53f8\u6709\u6743\u53d6\u6d88\u5ba2\u6237\u53c2\u52a0\u8d44\u683c\u3002\n        15. \u79ef\u5206\u5956\u8d4f\u4e8e\u4e3a2024\u5e741\u670810\u65e5\u524d\u5b58\u5165\u5ba2\u6237\u7684\u4f1a\u5458\u8d26\u6237\u5185\u3002\n        16. \u6240\u6709\u79ef\u5206\u5956\u8d4f\u5747\u4e0d\u53ef\u9000\u6362\u6216\u5151\u6362\u73b0\u91d1\uff0c\u4ea6\u4e0d\u80fd\u66f4\u6362\u4e36\u9000\u6b3e\u4e36\u8f6c\u8ba9\u53ca\u8f6c\u552e\u4e36\u66f4\u6362\u5176\u4ed6\u5956\u54c1\u53ca/\u6216\u6b3e\u8272\u66ff\u4ee3\u3002\n        17. \u82f1\u7687\u91d1\u878d\u96c6\u56e2\u7684\u6240\u6709\u5458\u5de5\u53ca\u5176\u4eb2\u53cb\u5747\u4e0d\u80fd\u53c2\u4e0e\u6b64\u63a8\u5e7f\u3002\n        18. \u6709\u5173\u672c\u63a8\u5e7f\u7684\u8be6\u60c5\u3001\u6539\u52a8\u6216\u53d6\u6d88\uff0c\u5c06\u4ee5\u672c\u516c\u53f8\u5728\u5b98\u65b9\u7f51\u7ad9https://www.empfs.com\u516c\u5e03\u7684\u4e3a\u51c6\u3002\n        19. \u672c\u516c\u53f8\u4fdd\u7559\u66f4\u6539\u6b64\u6761\u6b3e\u53ca\u7ec6\u5219\uff0c\u66f4\u6539\u6216\u7ec8\u6b62\u4efb\u4f55\u4f18\u60e0\u7684\u6743\u5229\uff0c\u800c\u6bcb\u987b\u53e6\u884c\u901a\u77e5\uff0c\u5e76\u4e00\u5207\u5747\u4ee5\u672c\u516c\u53f8\u4e4b\u89e3\u91ca\u4e3a\u51c6\u3002\n        20. \u53c2\u52a0\u8005\u53c2\u52a0\u662f\u6b21\u63a8\u5e7f\u4f18\u60e0\u53d7\u6b64\u6761\u6b3e\u7ea6\u675f\uff0c\u53c2\u52a0\u6b64\u63a8\u5e7f\u5373\u4ee3\u8868\u540c\u610f\u6761\u6b3e\u53ca\u7ec6\u5219\u3002\u5982\u672c\u516c\u53f8\u53d1\u73b0\u53c2\u52a0\u8005\u8fdd\u53cd\u63a8\u5e7f\u6761\u6b3e\uff0c\u5176\u53c2\u52a0\u8d44\u683c\u5c06\u88ab\u53d6\u6d88\u3002\u672c\u516c\u53f8\u4fdd\u7559\u6700\u7ec8\u51b3\u5b9a\u6743\u53ca\u6700\u7ec8\u89e3\u91ca\u6743\uff0c\u5e76\u5bf9\u63a8\u5e7f\u53c2\u4e0e\u8005\u5177\u7ea6\u675f\u529b\uff0c\u5982\u5bf9\u6b64\u4f18\u60e0\u6709\u4efb\u4f55\u67e5\u8be2\uff0c\u6b22\u8fce\u81f4\u7535 +852 8206 2500 \u4e0e\u672c\u516c\u53f8\u5ba2\u6237\u670d\u52a1\u90e8\u806f\u7edc\u3002\n        21. \u5f97\u5956\u8005\u5982\u6709\u4efb\u4f55\u6d89\u5acc\u6b3a\u8bc8\u3001\u8fdd\u53cd\u4efb\u4f55\u6cd5\u89c4\u6216\u4e0d\u6070\u5f53\u884c\u4e3a\u800c\u88ab\u672c\u516c\u53f8\u7ec8\u6b62\u5176\u8d26\u6237\uff0c\u672c\u516c\u53f8\u4fdd\u7559\u91c7\u53d6\u4efb\u4f55\u5fc5\u8981\u6cd5\u5f8b\u884c\u52a8\u7684\u6743\u5229\uff0c\u8ffd\u8ba8\u4efb\u4f55\u5df2\u8d60\u4e88\u7684\u5956\u54c1\u53ca\u56e0\u4e0a\u8ff0\u5f97\u5956\u8005\u4e4b\u884c\u4e3a\u6240\u4ea7\u751f\u4efb\u4f55\u6cd5\u5f8b\u8d23\u4efb\u6216\u635f\u5931\u3002\n        22. \u63a8\u5e7f\u7ec6\u5219\u672a\u8986\u76d6\u7684\u90e8\u5206\uff0c\u8bf7\u53c2\u9605\u672c\u516c\u53f8\u5ba2\u6237\u534f\u8bae\u76f8\u5173\u6761\u6b3e\u3002\n        23. \u672c\u63a8\u5e7f\u5e76\u4e0d\u6784\u6210\u53ca\u4e0d\u5e94\u88ab\u89c6\u4e3a\u4efb\u4f55\u5efa\u8bae\u3001\u63a8\u9500\u3001\u6e38\u8bf4\u5ba2\u6237\u8ba4\u8d2d\u6216\u51fa\u552e\u4efb\u4f55\u6295\u8d44\u4ea7\u54c1\u4e0e\u4e70\u5356\u4efb\u4f55\u6295\u8d44\u4ea7\u54c1\u3002\n        24. \u672c\u6761\u6b3e\u53ca\u7ec6\u5219\u53d7\u9999\u6e2f\u7279\u522b\u884c\u653f\u533a\u6cd5\u5f8b\u6240\u7ba1\u8f96\uff0c\u5e76\u6309\u7167\u9999\u6e2f\u7279\u522b\u884c\u653f\u533a\u6cd5\u5f8b\u8be0\u91ca\u3002\n        25. \u672c\u6761\u6b3e\u53ca\u7ec6\u5219\u53d7\u73b0\u884c\u76d1\u7ba1\u89c4\u5b9a\u7ea6\u675f\u3002",already_joined:"\u60a8\u5df2\u7ecf\u6ce8\u518c\u4e86\u8be5\u6d3b\u52a8\uff0c\u611f\u8c22\u60a8\u7684\u652f\u6301\u3002",contact_cs_title:"\u6211\u8d4f\u4f60\u8d5a",contact_cs_content:"\u6210\u4e3a\u4f1a\u5458\u8ba9\u4f60\u6bcf\u6b21\u4ea4\u6613\u8d5a\u5206\u6362\u4e30\u5bcc\u793c\u54c1\u3002",my_reward_landing_title:"\u5956\u52b1\u4e2d\u5fc3",mission_centre_title:"\u4efb\u52a1\u4e2d\u5fc3",my_reward_button:"\u6211\u7684\u5956\u52b1",level_title:"\u76ee\u524d\u9636\u6bb5\uff1a",referral_code_title:"\u4e2a\u4eba\u63a8\u8350\u7801:",btn_earn_point:"\u5feb